{
  "name": "@local/dsh-dynrestore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "description": "动态插件客户端恢复：页面刷新或连接重置后自动重挂动态插件的客户端半部。",
  "license": "MIT"
}
